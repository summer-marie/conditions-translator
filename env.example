# ============================================================
# Conditions Translator MVP
# Example environment configuration
#
# Copy this file to:
#   .env.local        for local development
#   or configure the same values in your deployment platform
#
# Never commit real secrets.
# Never prefix secrets with NEXT_PUBLIC_.
#
# Tags used below, based on an audit of what the codebase actually reads
# (2026-07-20):
#   [REQUIRED]  — read with no fallback; the app errors or degrades without it
#   [OPTIONAL]  — read with a hardcoded fallback in lib/constants.ts or
#                 elsewhere; only set to override the default
#   [PLATFORM]  — set by Vercel automatically, or only relevant to Vercel's
#                 own Cron feature; do not set locally
# ============================================================


# ============================================================
# Application
# ============================================================

# [OPTIONAL] Falls back to "Verity" in lib/constants.ts.
NEXT_PUBLIC_APP_NAME="Verity"

# NOT CURRENTLY READ by app code — app/layout.tsx hardcodes `metadataBase`
# to https://my-verity.com instead. Kept here as a placeholder in case
# metadata is wired to this var later; safe to omit until then.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Runtime environment. Set automatically by Next.js — do not set manually.
NODE_ENV="development"


# ============================================================
# Database
# ============================================================

# [REQUIRED] lib/database/prisma.ts — the Prisma Neon adapter is constructed
# with this value; the app cannot start without it.
# Intended MVP provider: Neon Postgres.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# [REQUIRED] prisma.config.ts — used for migrations/administrative tasks.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"


# ============================================================
# Authentication and Sessions
# ============================================================

# [REQUIRED] lib/env.ts's validateServerEnv() requires this for
# GET /api/health to report "ok". NOT currently used for token signing —
# auth sessions are opaque, random UUID tokens stored in the AuthSession
# table (lib/auth/session.ts), not signed/encrypted values. Set to any long
# random value; generate a secure one before deployment.
AUTH_SECRET="replace-with-a-long-random-secret"

# [OPTIONAL] Falls back to 24 in lib/constants.ts.
TEMP_SESSION_TTL_HOURS="24"

# [OPTIONAL] Falls back to 720 (30 days) in lib/constants.ts. Bounds how
# long a signed-in user's login cookie stays valid; saved Documents
# themselves never expire.
AUTH_SESSION_TTL_HOURS="720"

# [OPTIONAL] Falls back to 120 in lib/constants.ts.
CHAT_SESSION_TTL_MINUTES="120"

# [OPTIONAL] lib/auth/session.ts — falls back to true when NODE_ENV is
# "production", false otherwise.
AUTH_COOKIE_SECURE="false"

# [OPTIONAL] lib/auth/session.ts — falls back to "lax".
AUTH_COOKIE_SAME_SITE="lax"


# ============================================================
# OpenAI / AI
# ============================================================

# [REQUIRED] Read implicitly by the OpenAI SDK constructor (`new OpenAI()`)
# in lib/ocr/client.ts, lib/chat/client.ts, lib/sections/client.ts.
# Server-side only. Never rename this to NEXT_PUBLIC_OPENAI_API_KEY.
OPENAI_API_KEY="replace-with-your-openai-api-key"

# [REQUIRED] Each throws a distinct *_MODEL_NOT_CONFIGURED (500) error when
# unset (lib/ocr/client.ts, lib/sections/client.ts, lib/chat/client.ts).
# Keep model names configurable so testing can compare providers/models
# without changing application code.
OPENAI_OCR_MODEL="replace-with-vision-capable-model"
OPENAI_SECTION_MODEL="replace-with-section-generation-model"
OPENAI_CHAT_MODEL="replace-with-chat-model"

# [OPTIONAL] Falls back to 60000 in each OpenAI client module.
OPENAI_REQUEST_TIMEOUT_MS="60000"

# [OPTIONAL] Falls back to 2 in each OpenAI client module.
OPENAI_MAX_RETRIES="2"


# ============================================================
# OCR and Upload Limits
# ============================================================

# [OPTIONAL] Falls back to 10 in lib/constants.ts (feeds MAX_PAGE_SIZE_BYTES).
# Supported MVP types remain limited to: image/jpeg, image/png, image/webp.
OCR_MAX_FILE_MB="10"

# [OPTIONAL] Falls back to 10 in lib/constants.ts. Maximum accepted pages in
# one Document.
DOCUMENT_MAX_PAGES="10"

# [OPTIONAL] Falls back to 5000 in lib/constants.ts. Maximum length of a
# user-submitted OCR transcription correction.
OCR_MAX_CORRECTION_CHARACTERS="5000"


# ============================================================
# Document Processing
# ============================================================

# [OPTIONAL] Falls back to 3 in lib/constants.ts. Maximum READY Documents
# that may be selected in one chat.
CHAT_MAX_DOCUMENTS="3"

# [OPTIONAL] Falls back to 50000 in lib/constants.ts. Maximum combined
# confirmed source text included in one chat.
CHAT_MAX_CONFIRMED_CHARACTERS="50000"

# [OPTIONAL] Falls back to 20 in lib/constants.ts. Maximum user questions in
# one chat.
CHAT_MAX_USER_MESSAGES="20"

# [OPTIONAL] Falls back to 40 in lib/constants.ts. Maximum total messages in
# one chat.
CHAT_MAX_TOTAL_MESSAGES="40"

# [OPTIONAL] Falls back to 17 in lib/constants.ts. User-question count at
# which the UI may show a "start a fresh chat soon" warning.
CHAT_WARNING_USER_MESSAGES="17"


# ============================================================
# Object Storage
# ============================================================

# Intended MVP provider: Vercel Blob (private store). Server-side only.
#
# Per Vercel's current docs (verified 2026-07-20, vercel.com/docs/vercel-blob):
# every Blob store — private or public — gets a static BLOB_READ_WRITE_TOKEN
# automatically for whichever environments you select when the store is
# created/connected. Separately, connecting a store to a project also adds
# BLOB_STORE_ID + VERCEL_OIDC_TOKEN for OIDC auth (recommended on real Vercel
# infrastructure; short-lived, rotates automatically). The SDK resolves
# credentials in order: explicit token > OIDC (VERCEL_OIDC_TOKEN +
# BLOB_STORE_ID) > BLOB_READ_WRITE_TOKEN. lib/storage/blob.ts always passes
# BLOB_READ_WRITE_TOKEN explicitly when set, which wins outright — so it's
# what's actually used for local dev regardless of whether OIDC vars are
# also present locally.
#
# Correction: an earlier version of this comment claimed private stores
# can't get a static token from the dashboard — that's no longer accurate.
#
# To populate locally: `vercel link`, then `vercel env pull <file>` — pull
# into a separate file (not .env.local directly, since pull overwrites the
# whole target file) and copy over just the BLOB_READ_WRITE_TOKEN line.
#
# Do NOT commit real values for any variable below.

# [REQUIRED] lib/env.ts's validateServerEnv() requires this for
# GET /api/health to report "ok". NOT read directly by lib/storage/blob.ts
# in local dev (the OIDC path it would feed isn't used locally) — this only
# matters for the health check. Get it with: vercel blob list-stores
BLOB_STORE_ID="replace-with-blob-store-id"

# [PLATFORM] Short-lived (~12h), rotates. Vercel injects this automatically
# on real infrastructure; there is no dashboard copy. Not needed locally
# since BLOB_READ_WRITE_TOKEN below is the local-dev auth path.
VERCEL_OIDC_TOKEN="replace-with-oidc-token-from-vercel-env-pull"

# [REQUIRED locally] The actual local-dev storage auth mechanism.
# lib/storage/blob.ts passes it explicitly to every call when present,
# which @vercel/blob's SDK checks before ever consulting OIDC — so this
# only affects local dev. Leave unset on Vercel infrastructure
# (production/preview), where OIDC continues to be used automatically.
BLOB_READ_WRITE_TOKEN="replace-with-read-write-token"

# [OPTIONAL] Falls back to "conditions-translator" in lib/actions/document.ts
# and app/api/documents/[documentId]/pages/route.ts. Set per environment to
# separate storage paths (e.g. "conditions-translator/development").
BLOB_PATH_PREFIX="conditions-translator/development"


# ============================================================
# Temporary Data Cleanup
# ============================================================

# [REQUIRED] app/api/cron/cleanup/route.ts — checked against the incoming
# "Authorization: Bearer <value>" header; the route returns 401 without it.
CLEANUP_JOB_SECRET="replace-with-a-long-random-secret"

# [PLATFORM] Not read by app code — only relevant on Vercel. Vercel's own
# Cron feature auto-attaches "Authorization: Bearer <value>" to its
# invocations, but only for an env var literally named CRON_SECRET. Set
# this on Vercel to the SAME value as CLEANUP_JOB_SECRET above so the
# platform's auto-attached header matches what the route checks. Not
# needed in .env.local — trigger the route manually with a matching
# CLEANUP_JOB_SECRET bearer token instead. See docs/Deployment_Vercel.md.
CRON_SECRET="same-value-as-CLEANUP_JOB_SECRET"
