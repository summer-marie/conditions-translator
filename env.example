# ============================================================
# Conditions Translator MVP
# Example environment configuration
#
# Copy this file to:
#   .env.local        for local development
#   or configure the same values in your deployment platform
#
# Never commit real secrets.
# Never prefix secrets with NEXT_PUBLIC_.
# ============================================================


# ============================================================
# Application
# ============================================================

NEXT_PUBLIC_APP_NAME="Conditions Translator"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Runtime environment.
# Common values: development, test, production
NODE_ENV="development"


# ============================================================
# Database
# ============================================================

# PostgreSQL connection string.
# Intended MVP provider: Neon Postgres.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Optional direct connection string for migrations or administrative tasks.
# Use only if your database provider recommends a separate direct connection.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"


# ============================================================
# Authentication and Sessions
# ============================================================

# Long random secret used to sign or encrypt session data.
# Generate a secure value before deployment.
AUTH_SECRET="replace-with-a-long-random-secret"

# Temporary workspace/session lifetime.
TEMP_SESSION_TTL_HOURS="24"

# Temporary AI chat session lifetime.
# Adjust after testing the real user flow.
CHAT_SESSION_TTL_MINUTES="120"

# Secure cookies should be enabled in production.
AUTH_COOKIE_SECURE="false"

# Cookie SameSite policy.
# Recommended default: lax
AUTH_COOKIE_SAME_SITE="lax"


# ============================================================
# OpenAI / AI
# ============================================================

# Server-side only.
# Never rename this to NEXT_PUBLIC_OPENAI_API_KEY.
OPENAI_API_KEY="replace-with-your-openai-api-key"

# Keep model names configurable so testing can compare providers/models
# without changing application code.
OPENAI_OCR_MODEL="replace-with-vision-capable-model"
OPENAI_SECTION_MODEL="replace-with-section-generation-model"
OPENAI_CHAT_MODEL="replace-with-chat-model"

# Optional request timeout.
OPENAI_REQUEST_TIMEOUT_MS="60000"

# Optional retry count for transient provider errors.
OPENAI_MAX_RETRIES="2"


# ============================================================
# OCR and Upload Limits
# ============================================================

# Supported MVP types should remain limited to:
# image/jpeg, image/png, image/webp
OCR_MAX_FILE_MB="10"

# Users upload one page at a time.
OCR_MAX_IMAGES_PER_REQUEST="1"

# Maximum accepted pages in one Document.
DOCUMENT_MAX_PAGES="10"

# Avoid persistent raw-upload storage unless required.
OCR_STORE_UPLOADS="false"

# Keep disabled unless debugging locally.
# Raw OCR/document text should never be written to logs.
OCR_DEBUG_LOGGING="false"

# Optional image preprocessing guidance.
OCR_MAX_IMAGE_LONG_EDGE_PX="2000"
OCR_IMAGE_QUALITY="85"


# ============================================================
# Document Processing
# ============================================================

# Maximum READY Documents that may be selected in one chat.
CHAT_MAX_DOCUMENTS="3"

# Maximum combined confirmed source text included in one chat.
CHAT_MAX_CONFIRMED_CHARACTERS="50000"

# Maximum user questions in one chat.
CHAT_MAX_USER_MESSAGES="20"

# Maximum total messages in one chat.
CHAT_MAX_TOTAL_MESSAGES="40"

# Number of user questions after which the UI may show
# a "start a fresh chat soon" warning.
CHAT_WARNING_USER_MESSAGES="17"


# ============================================================
# Object Storage
# ============================================================

# Intended MVP provider: Vercel Blob (private store).
# Server-side only.
#
# IMPORTANT — Private Blob stores and OIDC auth (as of Vercel Blob GA, June 2026):
# When a Blob store is created with private access, Vercel no longer generates
# a static BLOB_READ_WRITE_TOKEN by default. Instead, authentication uses
# short-lived OIDC tokens automatically when running on Vercel infrastructure.
#
# For LOCAL DEVELOPMENT (Phase 4+), pull credentials from your Vercel project:
#
#   vercel env pull .env.local
#
# This command populates your local .env.local with the correct Blob credentials
# (BLOB_STORE_ID and BLOB_WEBHOOK_PUBLIC_KEY) tied to your private store.
# Run this once before starting Phase 4 work, and re-run if credentials rotate.
#
# Do NOT commit the values pulled by vercel env pull.
# Do NOT hardcode BLOB_READ_WRITE_TOKEN — it is no longer used for private stores.

BLOB_STORE_ID="replace-with-blob-store-id"
BLOB_WEBHOOK_PUBLIC_KEY="replace-with-blob-webhook-public-key"

# Optional prefix to separate project environments.
BLOB_PATH_PREFIX="conditions-translator/development"

# Private access is required — user documents are sensitive legal files.
BLOB_ACCESS_MODE="private"


# ============================================================
# Temporary Data Cleanup
# ============================================================

# Shared secret for protected cleanup routes or scheduled jobs.
CLEANUP_JOB_SECRET="replace-with-a-long-random-secret"

# Cleanup cadence is implementation-specific.
# Example values: 15, 30, 60
CLEANUP_INTERVAL_MINUTES="60"

# Number of times failed deletion steps may be retried.
DELETE_MAX_RETRIES="5"

# Delay between deletion retries.
DELETE_RETRY_DELAY_SECONDS="60"


# ============================================================
# Rate Limiting
# ============================================================

# Start conservatively, then tune after observing real usage.
RATE_LIMIT_ENABLED="true"

# OCR requests allowed per temporary session/user per window.
RATE_LIMIT_OCR_REQUESTS="10"

# Chat requests allowed per temporary session/user per window.
RATE_LIMIT_CHAT_REQUESTS="30"

# Auth requests allowed per IP/session per window.
RATE_LIMIT_AUTH_REQUESTS="10"

# Length of the rate-limit window.
RATE_LIMIT_WINDOW_MINUTES="15"

# Review during testing:
# - Are legitimate users blocked too early?
# - Are retries counted fairly?
# - Are OCR and chat tracked separately?
# - Can obvious abuse bypass the limits?


# ============================================================
# Logging and Diagnostics
# ============================================================

# Allowed values may include: debug, info, warn, error
LOG_LEVEL="info"

# Never enable sensitive payload logging in production.
LOG_SENSITIVE_CONTENT="false"

# Optional non-sensitive provider usage metadata.
LOG_AI_USAGE_METADATA="true"

# Optional request correlation IDs for debugging.
ENABLE_REQUEST_IDS="true"


# ============================================================
# Feature Flags
# ============================================================

# Keep deferred features disabled for MVP.
FEATURE_TEMPLATE_RECOGNITION="false"
FEATURE_PDF_UPLOAD="false"
FEATURE_DOCX_UPLOAD="false"
FEATURE_HEIC_UPLOAD="false"
FEATURE_PERSISTENT_CHAT_HISTORY="false"
FEATURE_RETRIEVAL_OPTIMIZATION="false"


# ============================================================
# Email / Password Recovery
# ============================================================

# Leave blank until email-based reset is implemented.
EMAIL_FROM=""
EMAIL_PROVIDER_API_KEY=""

# Public base URL used in password-reset links.
PASSWORD_RESET_BASE_URL="http://localhost:3000"

# Password reset token lifetime.
PASSWORD_RESET_TOKEN_TTL_MINUTES="30"


# ============================================================
# Development and Testing
# ============================================================

# Prevent accidental use of production services in local tests.
USE_MOCK_OPENAI="false"
USE_MOCK_STORAGE="false"

# Optional seeded test user credentials.
# Never use real credentials here.
TEST_USER_EMAIL="test@example.com"
TEST_USER_PASSWORD="replace-with-test-password"

# Optional fixed temporary session ID for local integration testing.
TEST_TEMP_SESSION_ID=""
