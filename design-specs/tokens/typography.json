{
  "fontFamily": {
    "primary": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "mono": "JetBrains Mono, 'Geist Mono', 'Fira Code', monospace"
  },
  "scale": {
    "display": {
      "size": "32px",
      "weight": 700,
      "letterSpacing": "-0.02em",
      "lineHeight": "1.2"
    },
    "h1": { "size": "24px", "weight": 700, "lineHeight": "1.3" },
    "h2": { "size": "20px", "weight": 600, "lineHeight": "1.4" },
    "h3": { "size": "16px", "weight": 600, "lineHeight": "1.4" },
    "body": { "size": "14px", "weight": 400, "lineHeight": "1.5" },
    "caption": { "size": "12px", "weight": 400, "lineHeight": "1.4" },
    "mono": { "size": "12px", "weight": 400, "lineHeight": "1.5" }
  }
}
