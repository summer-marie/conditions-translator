# Environment and secrets
.env*

# Local AI working memory
.agent-memory/
.cline/

# Dependencies and build output
node_modules/
.next/
out/
dist/
build/
coverage/

# Playwright output
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Local platform configuration
.vercel/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript generated files
*.tsbuildinfo
next-env.d.ts

# Generated Prisma client
/generated

# OS/editor artifacts
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.temp

# personal notes
/notes

# Claude Code local-only config (per-machine permissions/settings; the
# ".local" name is the tool's own convention for "don't commit this").
# .claude/session-memory/ is intentionally NOT ignored here — it's tracked
# so memory files survive a machine change instead of being lost locally.
.claude/settings.local.json

# Design files (exclude working files and large binaries; keep exports)
design-specs/**/*.psd
design-specs/**/*.ai
design-specs/**/*.figma
design-specs/**/*.xd
design-specs/**/*.sketch

# VSCode settings (per-user)
.vscode/
